# ============================================================
# Advanced Library Management System - Environment Configuration
# ============================================================

# Server & Deployment
PORT=3000
NODE_ENV=development
# For Render deployment, set CORS_ORIGIN to your Netlify URL:
CORS_ORIGIN=https://librarybs.netlify.app

# Permanent Database (MongoDB Community Server locally, or MongoDB Atlas connection string)
# Example Atlas URI: mongodb+srv://<username>:<password>@cluster0.mongodb.net/libraryos?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/advanced_library

# Fast Cache & Sessions (Redis URL)
# Example Render Key-Value / Upstash: rediss://default:<password>@<host>:<port>
REDIS_URL=redis://127.0.0.1:6379

# Express Session Encryption Secret
SESSION_SECRET=replace_with_a_cryptographically_secure_random_string_in_production

# Initial Administrative Accounts (Provisioned via npm run seed:admin)
ADMIN_NAME=Library Administrator
ADMIN_EMAIL=admin@library.local
ADMIN_PASSWORD=ChangeMe123!
SUPERADMIN_EMAIL=superadmin@library.local

# Library Policy Configuration
FINE_PER_DAY=5
DUE_SOON_DAYS=3
LOW_STOCK_THRESHOLD=2
